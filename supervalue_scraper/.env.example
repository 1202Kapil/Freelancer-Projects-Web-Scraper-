# ==============================================================================
# SuperValue NZ Scraper — Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# ==============================================================================

# 1. PICO PostgreSQL Database Connection (Stage-2 Ingestion)
DATABASE_URL=postgresql://user:password@pooler.pico.internal:5432/pico_prod

# 2. Proxy Configuration
SUPERVALUE_PROXY=

# 3. CapSolver API Key (Automated Cloudflare Turnstile Resolution)
CAPSOLVER_API_KEY=

# 4. Push Notifications (ntfy.sh Topic)
NTFY_TOPIC=pico-supervalue-alerts
