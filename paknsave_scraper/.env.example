# ==============================================================================
# PAK'nSAVE NZ Scraper — Environment Configuration Template
# Copy this file to .env and configure your production credentials.
# NOTE: Never commit .env or distribute session cookies to production packages!
# ==============================================================================

# 1. PICO PostgreSQL Database Connection (Stage-2 Catalog Ingestion)
# Single source of truth for branch IDs and observation storage.
DATABASE_URL=postgresql://user:password@pooler.pico.internal:5432/pico_prod

# 2. Proxy Configuration (Residential / Datacenter HTTP/HTTPS Proxy)
# Required when running without cloudflare bypass solver.
# Format: http://username:password@ip:port or http://ip:port
PAKNSAVE_PROXY=

# 3. CapSolver API Key (Automated Cloudflare Turnstile Resolution)
# If set, automatically solves Turnstile challenges when IP is challenged.
CAPSOLVER_API_KEY=

# 4. Push Notifications (ntfy.sh Topic)
# Topic name for operational pipeline alerts and daily scrape reports.
NTFY_TOPIC=pico-paknsave-alerts
